# Required: generate with: openssl rand -hex 32
AGENT_API_TOKEN=replace-with-a-long-random-secret

# Codex CLI authentication must already be configured for the service account.
# Never commit API keys or credentials.
PORT=8787

# When running locally from codex-agent/, the default workspace is the repository root.
# In Docker, set this to the mounted repository path.
# AGENT_WORKSPACE=/workspace

# Optional model override. Omit to use the Codex account's configured default.
# CODEX_MODEL=
