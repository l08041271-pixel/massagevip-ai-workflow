# Copy to .env on the VPS. Never commit the populated .env file.
POSTGRES_DB=massagevip
POSTGRES_USER=massagevip_app
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Existing application AI provider settings
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
AI_MODEL=REPLACE_WITH_SUPPORTED_MODEL

# Cloudflare Tunnel token from Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# Optional WhatsApp integration settings; only set the provider you actually use.
WAHA_BASE_URL=
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protect internal scheduled processing if enabled.
AGENT_CRON_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
