# Copy to .env and fill values. Never commit .env.
# This file is a template — all values are safe placeholders.

# ─────────────────────────────────────────────────────────────────────────────
# Core / Required
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required for persistence; omit for mock mode)
DATABASE_URL=postgresql://user:pass@host:5432/massagevip

# AI provider endpoint and credentials (required)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-replace-with-your-key
AI_MODEL=gpt-oss:120b-cloud

# HTTP server port (default: 8080)
PORT=8080

# Structured logging level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta)
# ─────────────────────────────────────────────────────────────────────────────

# Webhook verification token (set in Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=replace-me

# App secret for HMAC signature validation of incoming webhooks
WHATSAPP_APP_SECRET=replace-with-app-secret

# Phone number ID from Meta Business account
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id

# Permanent access token for the WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=replace-with-access-token

# ─────────────────────────────────────────────────────────────────────────────
# WAHA (WhatsApp HTTP API) — self-hosted WhatsApp gateway
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the WAHA service (default: http://localhost:3000)
WAHA_BASE_URL=http://localhost:3000

# WAHA session name (default: default)
WAHA_SESSION=default

# API key for WAHA authentication
WAHA_API_KEY=replace-with-waha-api-key

# Secret used to verify WAHA webhook payloads
WAHA_WEBHOOK_SECRET=replace-with-webhook-secret

# ─────────────────────────────────────────────────────────────────────────────
# CRM Integration
# ────────────────────────────────────────────────────────────────────────────═

# External CRM REST API base URL (optional — enables push/sync)
CRM_API_URL=https://your-crm.example.com/api

# CRM API authentication key
CRM_API_KEY=replace-with-crm-key

# ─────────────────────────────────────────────────────────────────────────────
# Lead Capture — Typeform & Click Tracking (NEW)
# ─────────────────────────────────────────────────────────────────────────────

# Typeform form ID embedded in the booking flow
TYPEFORM_FORM_ID=adMzykSH

# Typeform webhook signing secret (validates Typeform-Signature header)
TYPEFORM_SECRET=replace-with-typeform-signing-secret

# HMAC secret for the /track/whatsapp-click beacon (X-Signature header)
LEAD_WEBHOOK_SECRET=replace-with-random-secret

# Default attribution source when none is provided
LEAD_DEFAULT_SOURCE=whatsapp_click

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets Integration (NEW)
# ─────────────────────────────────────────────────────────────────────────────

# Google Sheets spreadsheet ID (from the sheet URL)
GOOGLE_SHEETS_ID=replace-with-spreadsheet-id

# Tab/sheet name for leads (default: Leads)
GOOGLE_SHEETS_LEAD_TAB=Leads

# Option A: full service-account JSON pasted inline (use single quotes in .env)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}

# Option B: path to a local service-account JSON file
GOOGLE_CREDENTIALS_PATH=/path/to/service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# Approval Notifiers (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token + chat ID for instant approval pushes
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Twilio (optional WhatsApp/SMS channel for approvals)
TWILIO_ACCOUNT_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Owner's WhatsApp number for approval pushes (e.g. whatsapp:+9665XXXXXXXX)
OWNER_WHATSAPP=whatsapp:+966500000000
